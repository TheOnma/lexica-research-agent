# Copy this file to `.env` and fill in your keys:
#   cp .env.example .env

# --- API keys (both required; the app constructs clients at import time) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: Semantic Scholar API key — raises rate limits for paper search.
S2_API_KEY=

# --- Services ---
# Celery broker + result backend. Defaults to redis://localhost:6379/0 when unset.
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
# Where the API stages uploads before the Celery worker ingests them.
# The API and worker processes must share this directory (docker-compose mounts it).
UPLOAD_DIR=/tmp/uploads
# ChromaDB persistent directory (shared by API and worker).
CHROMA_PERSIST_DIR=./data/chroma

# --- Optional overrides (defaults shown) ---
# LLM_MODEL=claude-sonnet-4-6
# FAST_MODEL=claude-haiku-4-5
# EMBEDDING_MODEL=text-embedding-3-small
